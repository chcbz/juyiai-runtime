{
  "configVersion": 1,
  "socketPath": "/run/cyf-agent-runtime-v1/unified/control.sock",
  "socketGid": 1000,
  "managedRoot": "/home/isp/state/cyf-agent-runtime-v1-managed/unified",
  "scopes": [
    {
      "tenantId": "TENANT_ID_REQUIRED",
      "clientId": "CLIENT_ID_REQUIRED",
      "ownerJiacn": "OWNER_JIACN_REQUIRED"
    }
  ],
  "enrollmentTtlMs": 3600000,
  "template": {
    "profile": {
      "codexBin": "/home/isp/apps/codex/bin/codex",
      "codexModel": "OPERATOR_MANAGED_MODEL_REQUIRED",
      "codexSandbox": "workspace-write",
      "codexApproval": "never",
      "chatEngine": "app-server",
      "chatModel": "OPERATOR_MANAGED_MODEL_REQUIRED",
      "chatSandbox": "read-only",
      "chatToolPolicy": "read-only-constrained",
      "nativeConversationHttpPollEnabled": false,
      "workspaceNoTaskPolicy": "reject",
      "nativeExecutionProviderId": "managed",
      "nativeExecutionProviderBaseUrl": "https://provider.example.invalid/v1",
      "nativeExecutionProviderWireApi": "responses",
      "nativeExecutionNetworkConnectTimeoutMs": 15000
    },
    "codexConfig": "cli_auth_credentials_store = \"file\"\nmodel = \"OPERATOR_MANAGED_MODEL_REQUIRED\"\nmodel_provider = \"managed\"\n[model_providers.managed]\nname = \"Operator-managed hosting provider\"\nbase_url = \"https://provider.example.invalid/v1\"\nwire_api = \"responses\"\nrequires_openai_auth = true\n",
    "modelAuth": {
      "auth_mode": "apikey",
      "OPENAI_API_KEY": "OPERATOR_MANAGED_SECRET_REQUIRED"
    }
  }
}
